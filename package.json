{
  "name": "@escapace/action-setup-vault",
  "description": "",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/action-setup-vault/issues",
  "devDependencies": {
    "@actions/core": "1.11.1",
    "@actions/tool-cache": "2.0.2",
    "@commitlint/cli": "19.7.1",
    "@commitlint/config-conventional": "19.7.1",
    "@escapace/pnpm-pack": "0.6.0",
    "@hashicorp/js-releases": "1.7.3",
    "@ls-lint/ls-lint": "2.2.3",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "3.0.6",
    "eslint": "9.31.0",
    "eslint-config-escapace": "5.8.0",
    "esroll": "0.4.1",
    "knip": "5.44.4",
    "lefthook": "1.10.10",
    "lodash-es": "4.18.1",
    "prettier": "3.5.1",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "13.0.2",
    "tsx": "4.19.3",
    "typescript": "6.0.3",
    "vitest": "3.0.6"
  },
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=10.4.1"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/action-setup-vault#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "esbuild"
    ]
  },
  "private": true,
  "repository": "escapace/action-setup-vault",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --production --no-optional --extract --pack-destination lib/action && echo '!*' > lib/action/.gitignore",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
