{
  "name": "@escapace/action-setup-vault",
  "description": "",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/action-setup-vault/issues",
  "devDependencies": {
    "@actions/cache": "6.2.0",
    "@actions/core": "3.0.1",
    "@actions/tool-cache": "4.0.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@escapace/pnpm-pack": "0.9.2",
    "@escapace/syncpack-configuration": "0.3.0",
    "@hashicorp/js-releases": "1.7.7",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/node": "24.13.3",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-config-escapace": "5.20.1",
    "esroll": "1.3.0",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "prettier-config-escapace": "1.2.2",
    "semver": "7.8.5",
    "syncpack": "15.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn",
      "version": "^10.33.0"
    },
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "^24.15.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/action-setup-vault#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "private": true,
  "repository": "escapace/action-setup-vault",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --production --no-optional --extract --pack-destination lib/action && echo '!*' > lib/action/.gitignore",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
