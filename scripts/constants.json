{
  "builds": {
    "node": {
      "banner": {
        "js": "import { createRequire as __createRequire } from 'module'; const require = __createRequire(import.meta.url);"
      },
      "define": {
        "__ENVIRONMENT__": "\"production\"",
        "__PLATFORM__": "\"node\""
      },
      "entryPoints": ["src/index.ts"],
      "mainFields": ["module", "main"],
      "outdir": "lib/node",
      "platform": "node",
      "splitting": false,
      "target": ["node20.15.0"]
    }
  }
}
